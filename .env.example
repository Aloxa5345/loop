# Database
# For connection pooling (runtime queries) - use pooled URL e.g. pooled.db.prisma.io
DATABASE_URL=
# Direct connection (for migrations) - use direct URL e.g. db.prisma.io (no pooler)
# Required if using a connection pooler like Prisma Accelerate or PgBouncer
DIRECT_URL=

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AI Keys
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LOOP Reports <your@email.com>
