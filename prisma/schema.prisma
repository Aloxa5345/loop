generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

generator clientDefault {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("postgres://ef0b660ffeea050747be51df471a356f6b4aacbc411c2af5865fd2bde72bebc6:sk_2uyOKVzwUHJxwA7TLpR99@pooled.db.prisma.io:5432/postgres?sslmode=require")
}

model User {
  id              String            @id @default(cuid())
  name            String
  email           String            @unique
  passwordHash    String
  createdAt       DateTime          @default(now())
  feedbacks       Feedback[]
  reports         Report[]
  schedules       ReportSchedule[]
  ownedWorkspaces Workspace[]
  workspaces      WorkspaceMember[]
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  createdAt   DateTime          @default(now())
  description String?
  ownerId     String
  industry    String?
  logo        String?
  timezone    String?
  feedbacks   Feedback[]
  reports     Report[]
  schedules   ReportSchedule[]
  themes      Theme[]
  owner       User              @relation(fields: [ownerId], references: [id])
  members     WorkspaceMember[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        Role
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, userId])
}

model Feedback {
  id              String          @id @default(cuid())
  content         String
  channel         String
  sourceRef       String?
  customerLabel   String
  sentimentScore  Float?
  createdAt       DateTime        @default(now())
  workspaceId     String
  aiSummary       String?
  updatedAt       DateTime        @updatedAt
  userId          String
  sentiment       String?
  status          FeedbackStatus  @default(PENDING)
  recommendations String?
  topics          String?
  analyzedAt      DateTime?
  keywords        String?
  aiStatus        String          @default("Pending")
  featureArea     String?
  category        String?
  customerEmail   String?
  priority        String?
  productArea     String?
  rating          Int?
  title           String?
  embedding       Embedding?
  user            User            @relation(fields: [userId], references: [id])
  workspace       Workspace       @relation(fields: [workspaceId], references: [id])
  themes          FeedbackTheme[]
}

model Theme {
  id          String          @id @default(cuid())
  name        String
  description String?
  color       String?
  workspaceId String
  feedbacks   FeedbackTheme[]
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
}

model FeedbackTheme {
  feedbackId String
  themeId    String
  confidence Float
  feedback   Feedback @relation(fields: [feedbackId], references: [id])
  theme      Theme    @relation(fields: [themeId], references: [id])

  @@id([feedbackId, themeId])
}

model Embedding {
  id         String   @id @default(cuid())
  feedbackId String   @unique
  vector     String
  feedback   Feedback @relation(fields: [feedbackId], references: [id])
}

model Report {
  id            String    @id @default(cuid())
  title         String
  periodStart   DateTime
  periodEnd     DateTime
  contentJson   Json
  createdAt     DateTime  @default(now())
  workspaceId   String
  generatedById String
  format        String    @default("PDF")
  shareToken    String?   @unique
  generatedBy   User      @relation(fields: [generatedById], references: [id])
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
}

model ReportSchedule {
  id          String    @id @default(cuid())
  email       String
  frequency   String
  format      String
  dayOfWeek   Int?
  hour        Int       @default(9)
  active      Boolean   @default(true)
  nextRun     DateTime
  lastRun     DateTime?
  createdAt   DateTime  @default(now())
  workspaceId String
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model ChatHistory {
  id          String   @id @default(cuid())
  question    String
  answer      String
  sources     String
  workspaceId String
  userId      String
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  userEmail   String
  userName    String
  action      String
  entity      String
  entityId    String?
  detail      String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  type        String
  title       String
  message     String
  read        Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Sentiment {
  POS
  NEU
  NEG
}

enum Status {
  NEW
  REVIEWED
  ACTIONED
}

enum FeedbackStatus {
  PENDING
  REVIEWED
  ANALYZED
}
